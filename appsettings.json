{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kubernetes": {
    "Enabled": false,
    "ApiServer": "https://kubernetes.default.svc",
    "TokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
    "CaFile": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
    "CacheSeconds": 45,
    "TimeoutSeconds": 5
  },
  "Strava": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "RefreshToken": "",
    "OAuthEndpoint": "https://www.strava.com/oauth/token",
    "ActivitiesEndpoint": "https://www.strava.com/api/v3/athlete/activities?per_page=20",
    "CacheMinutes": 10,
    "TimeoutSeconds": 8
  },
  "AllowedHosts": "*"
}
