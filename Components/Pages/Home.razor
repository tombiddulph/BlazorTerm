    private static IReadOnlyList<OutputLine> UnknownCommandLines(string command)
    {
        var suggestion = Commands
            .Select(candidate => new { Command = candidate, Distance = EditDistance(command, candidate) })
            .OrderBy(candidate => candidate.Distance)
            .First();

        return suggestion.Distance <= 3
            ? [Line(command + ": command not found", "error"), Link("Did you mean '" + suggestion.Command + "'?", suggestion.Command)]
            : [Line(command + ": command not found. Try 'help'.", "error")];
    }

    private static int EditDistance(string left, string right)
    {
        var previous = Enumerable.Range(0, right.Length + 1).ToArray();

        for (var i = 1; i <= left.Length; i++)
        {
            var current = new int[right.Length + 1];
            current[0] = i;

            for (var j = 1; j <= right.Length; j++)
            {
                var cost = left[i - 1] == right[j - 1] ? 0 : 1;
                current[j] = Math.Min(Math.Min(current[j - 1] + 1, previous[j] + 1), previous[j - 1] + cost);
            }

            previous = current;
        }

        return previous[right.Length];
    }

