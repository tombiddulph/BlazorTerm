            Line("       .----.       tom@portfolio", "heading"),
            Line("      / .--. \\      -------------"),
            Line("     | |    | |     Role: Senior Software Engineer"),
            Line("     | |.-\"\"-.|     Focus: C#, .NET, backend, fintech"),
            Line("    ///`.::::.`\\\\    Cloud: Azure + Service Bus"),
            Line("   ||| ::/  \\:: ;||   Observability: OpenTelemetry"),
            Line("   ||; ::\\__/:: ;||   Location: Leeds, UK"),
            Line("    \\\\ '::::' //    Homelab: Proxmox + Kubernetes"),
            Line("     `=':-..-'`     GitHub: 35 public repositories"),
            Line("                     Shell: Blazor / .NET 10 / C# 14"),
            External("                     github.com/tombiddulph", TerminalContent.GitHubUrl)
        ];
    }

    private static IReadOnlyList<TerminalLine> ManLines(string[] arguments)
    {
        if (arguments.Length > 0 && !arguments[0].Equals("tom", StringComparison.OrdinalIgnoreCase))
            return [Line("No manual entry for " + arguments[0], "error")];

        return
        [
            Line("TOM(1)                       PORTFOLIO MANUAL                       TOM(1)", "heading"),
            Line(string.Empty),
            Line("NAME", "heading"),
            Line("    Tom Biddulph - senior software engineer"),
            Line(string.Empty),
            Line("SYNOPSIS", "heading"),
            Line("    Backend-focused C# engineer building reliable web and fintech systems."),
            Line(string.Empty),
            Line("DESCRIPTION", "heading"),
            Line("    Builds accessible financial products at NewDay and open-source developer"),
            Line("    tooling around Azure, distributed messaging, and observability."),
            Line(string.Empty),
            Line("SEE ALSO", "heading"),
            Link("    resume(1), projects(1), contributions(1), contact(1)", "resume")
        ];
    }

    private static IReadOnlyList<TerminalLine> ResumeLines()
    {
        return
        [
            Line("TOM BIDDULPH", "heading"),
            Line("Senior Software Engineer / C# / Backend / Fintech"),
            Line("Leeds, United Kingdom"),
            Line(string.Empty),
            Line("EXPERIENCE", "heading"),
            Line("2023 - now   NewDay         Senior Software Engineer"),
