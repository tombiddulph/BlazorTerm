            Line("2018  [AND Digital]---- Associate"),
            Line("         |"),
            Line("2019  [NewDay]--------- Software Engineer"),
            Line("         |"),
            Line("2021  [Checkout.com]--- Software Engineer II"),
            Line("         |"),
            Line("2022  [Codat]---------- Senior Software Engineer"),
            Line("         |"),
