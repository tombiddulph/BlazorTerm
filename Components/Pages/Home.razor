    private IReadOnlyList<OutputLine> TourLines(string[] arguments)
    {
        if (arguments.Length > 1)
            return [Line("tour: too many arguments", "error"), Line("usage: tour [next|previous|<number>|stop]")];

        var control = arguments.Length == 0 ? string.Empty : arguments[0].ToLowerInvariant();
        if (control == "stop")
        {
            Session.TourStep = 0;
            return [Line("Tour stopped. Run 'tour' whenever you want to resume.")];
        }

        if (control == string.Empty)
            Session.TourStep = Session.TourStep is >= 1 and <= 6 ? Session.TourStep : 1;
        else if (control == "next")
            Session.TourStep = Session.TourStep is >= 1 and < 6 ? Session.TourStep + 1 : Session.TourStep == 6 ? 6 : 1;
        else if (control == "previous")
            Session.TourStep = Session.TourStep is > 1 and <= 6 ? Session.TourStep - 1 : 1;
        else if (int.TryParse(control, out var requestedStep) && requestedStep is >= 1 and <= 6)
            Session.TourStep = requestedStep;
        else
            return [Line($"tour: unknown step or control '{arguments[0]}'", "error"), Line("usage: tour [next|previous|1|2|3|4|5|6|stop]")];

        (string Title, string Description, string Command, string Label)[] steps =
        [
            ("PROFILE", "Meet Tom and inspect the terminal CV.", "about", "run: about"),
            ("PROJECTS", "Browse selected work and open a project case study.", "projects", "run: projects"),
            ("PIPES", "Compose output with the six shell-style filters.", "resume | grep -i azure | head -n 3", "run: resume | grep -i azure | head -n 3"),
            ("TRACE", "Inspect the real activity waterfall for a local command.", "trace resume", "run: trace resume"),
            ("FILESYSTEM", "Explore the content-backed virtual filesystem.", "tree", "run: tree"),
            ("FINISH", "Keep exploring through concise help or generated manuals.", "help", "run: help")
        ];
        var step = steps[Session.TourStep - 1];
        List<OutputLine> lines =
        [
            Line($"TOUR {Session.TourStep}/6 / {step.Title}", "heading"),
            Line(step.Description),
            Link(step.Label, step.Command),
            Line(string.Empty)
        ];
        if (Session.TourStep > 1)
            lines.Add(Link("previous", "tour previous"));
        if (Session.TourStep < 6)
            lines.Add(Link("next", "tour next"));
        else
            lines.Add(Link("finish tour", "tour stop"));
        lines.Add(Link("stop", "tour stop"));
        return lines;
    }

    private static IReadOnlyList<OutputLine> ManLines(string[] arguments)
    {
        if (arguments.Length == 0)
            return [Line("man: missing manual name", "error"), Line("usage: man <command>")];
        if (arguments.Length > 1)
            return [Line("man: too many arguments", "error"), Line("usage: man <command>")];

        var requested = arguments[0];
        if (requested.Equals("tom", StringComparison.OrdinalIgnoreCase))
        {
            return
            [
                Line("TOM(1)                       PORTFOLIO MANUAL                       TOM(1)", "heading"),
                Line(string.Empty),
                Line("NAME", "heading"),
                Line("    Tom Biddulph - senior software engineer"),
                Line(string.Empty),
                Line("SYNOPSIS", "heading"),
                Line("    Backend-focused C# engineer building reliable web and fintech systems."),
                Line(string.Empty),
                Line("DESCRIPTION", "heading"),
                Line("    Builds accessible financial products at NewDay and open-source developer"),
                Line("    tooling around Azure, distributed messaging, and observability."),
                Line(string.Empty),
                Line("SEE ALSO", "heading"),
                Link("    resume(1)", "resume"),
                Link("    projects(1)", "projects"),
                Link("    contributions(1)", "contributions"),
                Link("    contact(1)", "contact")
            ];
        }

        var documentation = CommandCatalog.Find(requested);
        if (documentation is null)
        {
            var suggestion = CommandCatalog.Suggest(requested, manuals: true);
            return suggestion is null
                ? [Line($"man: no manual entry for '{requested}'", "error")]
                : [Line($"man: no manual entry for '{requested}'", "error"), Link($"Did you mean '{suggestion}'?", $"man {suggestion}")];
        }

        List<OutputLine> lines =
        [
            Line($"{documentation.Name.ToUpperInvariant()}(1)                       BLAZORTERM MANUAL", "heading"),
            Line(string.Empty),
            Line("NAME", "heading"),
            Line($"    {documentation.Name} - {documentation.Description}"),
            Line(string.Empty),
            Line("SYNOPSIS", "heading"),
            Line("    " + documentation.Synopsis),
            Line(string.Empty),
            Line("DESCRIPTION", "heading"),
            Line("    " + documentation.Description)
        ];
        if (documentation.Examples is { Count: > 0 })
        {
            lines.Add(Line(string.Empty));
            lines.Add(Line("EXAMPLES", "heading"));
            lines.AddRange(documentation.Examples.Select(example => Link("    " + example, example)));
        }
        lines.Add(Line(string.Empty));
        lines.Add(Line("SEE ALSO", "heading"));
        var related = documentation.SeeAlso ?? CommandCatalog.Entries
            .Where(entry => entry.Category == documentation.Category && entry.Name != documentation.Name)
            .Take(3)
            .Select(entry => entry.Name)
            .ToArray();
        lines.AddRange(related.Select(name => Link($"    {name}(1)", $"man {name}")));
        return lines;
    }

