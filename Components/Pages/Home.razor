    private IReadOnlyList<OutputLine> EnterVim(string[] arguments)
    {
        if (arguments.Length > 1)
            return [Line("vim: too many file names", "error")];

        _vimMode = true;
        _vimMessage = "VIM - Vi IMproved";
        _vimHintCancellation?.Cancel();
        _vimHintCancellation?.Dispose();
        _vimHintCancellation = new CancellationTokenSource();
        _ = ShowVimHintAsync(_vimHintCancellation.Token);
        return [Line(arguments.Length == 0 ? "Vim opened an empty read-only buffer." : $"Vim opened '{arguments[0]}' read-only.")];
    }

    private void HandleVimInput(string input)
    {
        Input = string.Empty;
        if (input == ":q!")
        {
            _vimMode = false;
            _vimMessage = string.Empty;
            _vimHintCancellation?.Cancel();
            _vimHintCancellation?.Dispose();
            _vimHintCancellation = null;
            return;
        }

        _vimMessage = string.IsNullOrEmpty(input)
            ? "Type :q! and press Enter to leave Vim."
            : $"E492: Not an editor command: {input}";
    }

    private async Task ShowVimHintAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
            await InvokeAsync(() =>
            {
                if (_vimMode)
                {
                    _vimMessage = "Hint: type :q! and press Enter to return to the shell.";
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

