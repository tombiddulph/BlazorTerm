    private IReadOnlyList<OutputLine> WhoLines()
    {
        var snapshot = Telemetry.Snapshot();
        var connection = snapshot.ActiveCircuits == 1
            ? "this session is connected"
            : $"{snapshot.ActiveCircuits} anonymous sessions connected";
        return
        [
            Line("SESSION", "heading"),
            Line($"user       {TerminalContent.Owner}"),
            Line($"started    {SessionStarted:yyyy-MM-dd HH:mm:ss zzz}"),
            Line($"duration   {FormatUptime(DateTimeOffset.Now - SessionStarted)}"),
            Line($"circuits   {connection}"),
            Line("privacy    no identity or location data collected")
