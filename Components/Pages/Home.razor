    private IReadOnlyList<OutputLine> VersionLines()
    {
        List<OutputLine> lines =
        [
            Line("BLAZORTERM VERSION", "heading"),
            Line($"build      {BuildInformation.BuildTimestamp}"),
            Line($"runtime    {BuildInformation.Framework}"),
            Line($"uptime     {FormatUptime(Telemetry.Snapshot().Uptime)}")
        ];
        var sha = BuildInformation.GitSha;
        lines.Insert(1, sha == "development"
            ? Line("revision   development")
            : new LinkLine($"revision   {sha}", $"https://github.com/tombiddulph/BlazorTerm/commit/{sha}", LinkKind.Web, true) { Style = "accent" });
        return lines;
    }

    private static string FormatUptime(TimeSpan uptime)
    {
        return uptime.TotalDays >= 1
            ? $"{(int)uptime.TotalDays}d {uptime:hh\\:mm\\:ss}"
            : uptime.ToString("hh\\:mm\\:ss");
    }

