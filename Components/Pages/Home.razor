@page "/"
@rendermode InteractiveServer
@using System.Diagnostics
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TerminalTelemetry Telemetry
@inject IConfiguration Configuration

<PageTitle>@TerminalContent.PageTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@TerminalContent.MetaDescription" />
    <link rel="canonical" href="@TerminalContent.SiteUrl/" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="@TerminalContent.PageTitle" />
    <meta property="og:description" content="@TerminalContent.MetaDescription" />
    <meta property="og:url" content="@TerminalContent.SiteUrl/" />
    <meta property="og:image" content="@TerminalContent.SiteUrl/og-card.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tom Biddulph's terminal portfolio" />
</HeadContent>

<a class="skip-link" href="#portfolio-content">Skip to portfolio content</a>
<div class="site-shell @Theme">
    <section class="terminal-window" aria-label="Interactive personal terminal">
        <header class="iterm-header">
            <div class="traffic-lights" aria-hidden="true">
                <span class="close"></span>
                <span class="minimize"></span>
                <span class="maximize"></span>
            </div>
            <div class="terminal-tab active">
                <span class="tab-symbol">&gt;_</span>
                <span>@TerminalContent.Owner@@@TerminalContent.Host: @CurrentPath</span>
            </div>
            <button class="new-tab" type="button" aria-label="New tab">+</button>
            <div class="header-title">1. zsh</div>
        </header>

        <div class="workspace">
            <div class="terminal" id="terminal-output">
                <div class="terminal-log" role="log" aria-live="polite" aria-relevant="additions text">
                    <div class="session-intro">
                        <div class="login-line">Last login: @SessionStarted.ToString("ddd MMM dd HH:mm:ss") on ttys001</div>
                        <div class="identity-line"><strong>@TerminalContent.DisplayName</strong><span>Senior Software Engineer / C# + Backend</span></div>
                        <div class="intro-hint">Type <button class="inline-command" @onclick='() => RunShortcut("help")'>help</button> to explore, or find me on <a href="@TerminalContent.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a> and <a href="@TerminalContent.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</div>
                    </div>

                    @foreach (var entry in Entries)
                    {
                        <div class="history-entry">
                            <div class="prompt-row executed">
                                <Prompt Path="@entry.Path" />
                                <span class="executed-command">@entry.Command</span>
                            </div>
                            @foreach (var line in entry.Result.Lines)
                            {
                                @if (line is RawLine { Kind: RawLineKind.Neofetch })
                                {
                                    <NeofetchOutput />
                                }
                                else if (line is HelpLine helpLine)
                                {
                                    <div class="output-line @line.Style">
                                        @if (helpLine.Kind == LinkKind.Command)
                                        {
                                            <button class="output-command help-command" @onclick="() => RunShortcut(helpLine.Target)"><OutputText Text="@helpLine.Label" Highlights="@helpLine.Highlights" /></button>
                                        }
                                        else if (helpLine.Kind == LinkKind.Web)
                                        {
                                            <a class="output-link help-command" href="@helpLine.Target" target="_blank" rel="noopener noreferrer"><OutputText Text="@helpLine.Label" Highlights="@helpLine.Highlights" /></a>
                                        }
                                        else
                                        {
                                            <span class="help-command"><OutputText Text="@helpLine.Label" Highlights="@helpLine.Highlights" /></span>
                                        }
                                        <span class="help-description"><OutputText Text="@helpLine.Description" Highlights="@helpLine.DescriptionHighlights" /></span>
                                    </div>
                                }
                                else if (line is TraceLine traceLine)
                                {
                                    <div class="output-line @line.Style">
                                        @if (traceLine.Highlights.Count > 0)
                                        {
                                            <OutputText Text="@traceLine.DisplayText" Highlights="@traceLine.Highlights" />
                                        }
                                        else
                                        {
                                            <span class="trace-label">@traceLine.Label</span>
                                            <span class="trace-bar" aria-hidden="true">@traceLine.Bar</span>
                                            <span class="trace-duration">@traceLine.DurationText</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="output-line @line.Style">
                                    @if (line is LinkLine { Kind: LinkKind.Command } commandLink)
                                    {
                                        <button class="output-command" @onclick="() => RunShortcut(commandLink.Target)"><OutputText Text="@commandLink.Label" Highlights="@commandLink.Highlights" /></button>
                                    }
                                    else if (line is LinkLine webLink)
                                    {
                                        <a class="output-link" href="@webLink.Target" target="@(webLink.OpenInNewTab ? "_blank" : null)" rel="@(webLink.OpenInNewTab ? "noopener noreferrer" : null)"><OutputText Text="@webLink.Label" Highlights="@webLink.Highlights" /></a>
                                    }
                                    else
                                    {
                                        <OutputText Text="@line.DisplayText" Highlights="@line.Highlights" />
                                    }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <label class="prompt-row active-prompt" for="terminal-input">
                    <Prompt Path="@CurrentPath" />
                    <input id="terminal-input"
                           class="command-input"
                           value="@Input"
                           @onchange="UpdateInput"
                           @onkeydown="HandleKeyDown"
                           data-command-completions="@string.Join(',', Commands)"
                           data-filter-completions="@string.Join(',', Pipeline.FilterNames)"
                           data-path-completions="@string.Join(',', VirtualFileSystem.Completions(CurrentPath))"
                           data-directory-completions="@string.Join(',', VirtualFileSystem.Completions(CurrentPath, directoriesOnly: true))"
                           data-project-completions="@string.Join(',', TerminalContent.Projects.Select(project => project.Slug))"
                           autocomplete="off"
                           autocapitalize="off"
                           enterkeyhint="send"
                           inputmode="text"
                           spellcheck="false"
                           aria-label="Terminal command" />
                    <span class="cursor" aria-hidden="true"></span>
                </label>
                <nav class="command-chips" aria-label="Suggested terminal commands">
                    @foreach (var command in SuggestedCommands)
                    {
                        <button type="button" @onclick="() => RunShortcut(command)">@command</button>
                    }
                </nav>
            </div>
        </div>

        <footer class="terminal-footer">
            <span><kbd>↑</kbd><kbd>↓</kbd> HISTORY</span>
            <span><kbd>TAB</kbd> COMPLETE</span>
            <span><kbd>CTRL</kbd> + <kbd>L</kbd> CLEAR</span>
            <span class="footer-location">@TerminalContent.Owner@@@TerminalContent.Host:@CurrentPath</span>
        </footer>
    </section>
</div>

<PortfolioOverview Class="semantic-fallback" />

@code {
    private static readonly string[] Commands =
    [
        "help", "neofetch", "man", "about", "resume", "stack", "hosting", "timeline", "status",
        "experience", "education", "skills", "projects", "project", "contributions",
        "contact", "github", "linkedin", "open", "history", "ls", "cat", "cd", "pwd", "tree",
        "whoami", "who", "date", "version", "git", "clear", "theme", "gui", "telemetry", "trace", "coffee", "fortune", "sudo",
        "grep", "head", "tail", "wc", "sort", "uniq"
    ];

    private static readonly string[] SuggestedCommands = ["resume", "projects", "stack", "contact", "telemetry"];

    private static readonly IReadOnlyDictionary<string, string> Aliases =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["?"] = "help",
            ["bio"] = "about",
            ["cv"] = "resume",
            ["repos"] = "projects",
            ["oss"] = "contributions",
            ["work"] = "experience",
            ["cls"] = "clear"
        };

    private static readonly PipelineExecutor Pipeline = new();

    private int _historyIndex;
    private bool _shouldFocus = true;

    [PersistentState]
    public TerminalSession? PersistedSession { get; set; }

    [SupplyParameterFromQuery(Name = "cmd")]
    public string? RequestedCommand { get; set; }

    private TerminalSession Session => PersistedSession ??= new();
    private List<HistoryEntry> Entries => Session.Entries;
    private List<string> CommandHistory => Session.CommandHistory;
    private string Input { get => Session.Input; set => Session.Input = value; }
    private string Theme { get => Session.Theme; set => Session.Theme = value; }
    private string CurrentPath { get => Session.CurrentPath; set => Session.CurrentPath = value; }
    private DateTimeOffset SessionStarted => Session.Started;
    protected override void OnInitialized()
    {
        _historyIndex = CommandHistory.Count;

        if (Entries.Count == 0 && CommandHistory.Count == 0)
        {
            Execute("neofetch");
            Execute("whoami");

            if (!string.IsNullOrWhiteSpace(RequestedCommand) && RequestedCommand.Length <= 100)
                Execute(RequestedCommand);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await JS.InvokeVoidAsync("terminalUi.focusAndScroll", "terminal-input", "terminal-output");
        }
    }

    private void UpdateInput(ChangeEventArgs args)
    {
        Input = args.Value == null ? string.Empty : args.Value.ToString() ?? string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.CtrlKey && args.Key.Equals("l", StringComparison.OrdinalIgnoreCase))
        {
            Entries.Clear();
            Input = string.Empty;
            await JS.InvokeVoidAsync("terminalUi.clear", "terminal-input");
            await RequestFocus();
            return;
        }

        switch (args.Key)
        {
            case "Enter":
                Execute(Input);
                await RequestFocus();
                break;
            case "ArrowUp":
                if (_historyIndex > 0)
                    Input = CommandHistory[--_historyIndex];
                break;
            case "ArrowDown":
                if (_historyIndex < CommandHistory.Count - 1)
                    Input = CommandHistory[++_historyIndex];
                else
                {
                    _historyIndex = CommandHistory.Count;
                    Input = string.Empty;
                }
                break;
        }
    }

    private async Task RunShortcut(string command)
    {
        Execute(command);
        await JS.InvokeVoidAsync("terminalUi.clear", "terminal-input");
        await RequestFocus();
    }

    private Task RequestFocus()
    {
        _shouldFocus = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Execute(string rawCommand)
    {
        var fullCommand = rawCommand.Trim();
        Input = string.Empty;

        if (fullCommand.Length == 0)
            return;

        CommandHistory.Add(fullCommand);
        _historyIndex = CommandHistory.Count;
        var executionPath = CurrentPath;

        if (!ShellParser.TryParse(fullCommand, out var parsedSegments, out var parseError))
        {
            Entries.Add(new(fullCommand, executionPath, new CommandResult([Line(parseError, "error")], 2)));
            return;
        }

        if (parsedSegments.Count == 0)
            return;

        var segments = parsedSegments.ToArray();
        var first = segments[0];
        segments[0] = first with { Name = Aliases.GetValueOrDefault(first.Name, first.Name) };

        if (segments.Length == 1 && segments[0].Name == "gui")
        {
            Navigation.NavigateTo("/resume");
            return;
        }

        var result = Pipeline.Execute(
            segments,
            command => Commands.Contains(command, StringComparer.OrdinalIgnoreCase)
                ? new DelegateCommand(invocation => RunCommand(command, invocation.Arguments.ToArray()))
                : null);

        if (segments[0].Name != "clear")
            Entries.Add(new HistoryEntry(fullCommand, executionPath, result));
    }

    private CommandResult RunCommand(string command, string[] arguments)
    {
        if (command == "trace")
            return TraceCommand(arguments);

        using var commandActivity = TerminalActivities.Source.StartActivity("command.execute");
        commandActivity?.SetTag("command.name", command);
        commandActivity?.SetTag("command.argument.count", arguments.Length);

        IReadOnlyList<OutputLine> lines;
        using (var contentActivity = TerminalActivities.Source.StartActivity("content.load"))
        {
            contentActivity?.SetTag("content.command", command);
            lines = RunCommandLines(command, arguments);
            contentActivity?.SetTag("content.line.count", lines.Count);
        }

        using var formatActivity = TerminalActivities.Source.StartActivity("output.format");
        var exitCode = lines.Any(line => line.Style == "error") ? 1 : 0;
        formatActivity?.SetTag("output.line.count", lines.Count);
        formatActivity?.SetTag("output.exit.code", exitCode);
        commandActivity?.SetTag("command.exit.code", exitCode);
        if (exitCode != 0)
            commandActivity?.SetStatus(ActivityStatusCode.Error, lines.FirstOrDefault()?.ToPlainText());
        return new(lines, exitCode);
    }

    private CommandResult TraceCommand(string[] arguments)
    {
        var verbose = arguments.Length > 0 && arguments[0] == "-v";
        var commandIndex = verbose ? 1 : 0;
        if (arguments.Length <= commandIndex)
            return new([Line("trace: missing command", "error"), Line("usage: trace [-v] <command>")], 2);

        var command = arguments[commandIndex].ToLowerInvariant();
        command = Aliases.GetValueOrDefault(command, command);
        if (command == "trace")
            return new([Line("trace: refusing to trace trace recursively", "error")], 2);

        using var collector = new CommandTraceCollector();
        using var rootScope = TerminalActivities.StartRoot($"command.{command}");
        var root = rootScope.Activity;
        if (root is null)
            return new([Line("trace: activity source is unavailable", "error")], 1);

        collector.Capture(root.TraceId, root.SpanId);
        root.SetTag("command.name", command);
        root.SetTag("command.argument.count", arguments.Length - commandIndex - 1);

        CommandResult result;
        try
        {
            result = RunCommand(command, arguments[(commandIndex + 1)..]);
            root.SetTag("command.exit.code", result.ExitCode);
            root.SetStatus(result.ExitCode == 0 ? ActivityStatusCode.Ok : ActivityStatusCode.Error);
        }
        catch (Exception exception)
        {
            root.SetTag("exception.type", exception.GetType().FullName);
            root.SetStatus(ActivityStatusCode.Error, exception.Message);
            result = new([Line($"{command}: command execution failed", "error")], 1);
        }

        rootScope.Stop();
        var traceOutput = TraceOutputFormatter.Format(
            collector.Snapshot(),
            verbose,
            collector.DiscardedCount,
            !string.IsNullOrWhiteSpace(Configuration["OTEL_EXPORTER_OTLP_ENDPOINT"]));
        return traceOutput with { ExitCode = result.ExitCode };
    }

    private IReadOnlyList<OutputLine> RunCommandLines(string command, string[] arguments)
    {
        switch (command)
        {
            case "help":
                return new[]
                {
                    Line("AVAILABLE COMMANDS", "heading"),
                    Line("PROFILE", "help-heading"),
                    HelpLink("about", "A short introduction", "about"),
                    HelpLink("resume", "Terminal-formatted CV", "resume"),
                    HelpLink("experience", "Professional history", "experience"),
                    HelpLink("stack", "Technologies and specialisms", "stack"),
                    HelpLink("timeline", "Career history at a glance", "timeline"),
                    HelpLink("education", "Degree and university", "education"),
                    Line(string.Empty),
                    Line("NAVIGATE", "help-heading"),
                    HelpLink("projects", "Selected GitHub projects", "projects"),
                    HelpLink("project <name>", "Open a project case study", "project service-bus-explorer"),
                    HelpLink("contributions", "Open-source contributions", "contributions"),
                    HelpLink("contact", "Ways to get in touch", "contact"),
                    HelpLink("gui", "Open the plain web resume", "gui"),
                    HelpExternal("github", "Open my GitHub profile", TerminalContent.GitHubUrl),
                    HelpExternal("linkedin", "Open my LinkedIn profile", TerminalContent.LinkedInUrl),
                    Line(string.Empty),
                    Line("SYSTEM", "help-heading"),
                    HelpLink("ls", "List files", "ls"),
                    HelpLink("cat <file>", "Read a file", "cat about.txt"),
                    HelpLine("cd <directory>", "Change working directory"),
                    HelpLine("pwd", "Print working directory"),
                    HelpLine("tree [path]", "Show the filesystem tree"),
                    HelpLine("whoami", "Print the current user"),
                    HelpLine("date", "Print server time"),
                    HelpLine("version", "Build provenance and runtime details"),
                    HelpLine("who", "Anonymous connection and session details"),
                    HelpLine("git log --oneline", "Browse career history as commits"),
                    HelpLink("history", "Show this session's commands", "history"),
                    HelpLine("theme <name>", "Switch between green and amber"),
                    HelpLine("clear", "Clear the terminal"),
                    HelpLink("telemetry", "Live application health", "telemetry"),
                    HelpLine("trace [-v] <command>", "Render a command's activity waterfall"),
                    Line(string.Empty),
                    Line("FILTERS", "help-heading"),
                    HelpLine("grep [-i] [-v] <pattern>", "Filter lines by a regular expression"),
                    HelpLine("head [-n count]", "Show the first lines"),
                    HelpLine("tail [-n count]", "Show the last lines"),
                    HelpLine("wc [-l]", "Count lines, words, and characters"),
                    HelpLine("sort [-r]", "Sort lines"),
                    HelpLine("uniq", "Remove adjacent duplicate lines")
                };
            case "neofetch":
                return NeofetchLines();
            case "man":
                return ManLines(arguments);
            case "about":
            case "experience":
            case "education":
            case "skills":
            case "hosting":
                return ReadFile(command + ".txt");
            case "projects":
                return ProjectLines();
            case "project":
                return ProjectDetailLines(arguments);
            case "contributions":
                return ContributionLines();
            case "resume":
                return ResumeLines();
            case "stack":
                return StackLines();
            case "timeline":
                return TimelineLines();
            case "status":
                return StatusLines();
            case "telemetry":
                return TelemetryLines();
            case "contact":
                return ContactLines();
            case "ls":
                return ListDirectory(arguments);
            case "cat":
                return CatFile(arguments);
            case "cd":
                return ChangeDirectory(arguments);
            case "pwd":
                return [Line(VirtualFileSystem.ToAbsolutePath(CurrentPath))];
            case "tree":
                return TreeLines(arguments);
            case "whoami":
                return new[] { Line(TerminalContent.Owner) };
            case "who":
                return WhoLines();
            case "date":
                return new[] { Line(DateTimeOffset.Now.ToString("ddd MMM dd HH:mm:ss zzz yyyy")) };
            case "version":
                return VersionLines();
            case "git":
                return CareerGit.Execute(arguments);
            case "linkedin":
                return new[] { External("linkedin.com/in/tabiddulph", TerminalContent.LinkedInUrl) };
            case "github":
                return GitHubLines();
            case "open":
                return OpenLines(arguments);
            case "history":
                return HistoryLines();
            case "coffee":
                return CoffeeLines();
            case "fortune":
                return FortuneLines();
            case "sudo":
                return new[] { Line("tom is not in the sudoers file. This incident will be reported.", "error") };
            case "clear":
                Entries.Clear();
                return Array.Empty<OutputLine>();
            case "theme":
                return SetTheme(arguments);
            default:
                return UnknownCommandLines(command);
        }
    }

    private IReadOnlyList<OutputLine> ReadFile(string fileName)
    {
        return TerminalFormatter.ReadFile(fileName);
    }

    private IReadOnlyList<OutputLine> ChangeDirectory(string[] arguments)
    {
        if (arguments.Length > 1)
            return [Line("cd: too many arguments", "error")];

        var requested = arguments.Length == 0 ? "~" : arguments[0];
        if (!VirtualFileSystem.TryResolve(CurrentPath, requested, out var resolution))
            return [Line($"cd: {requested}: No such file or directory", "error")];
        if (resolution.Node is not DirectoryNode)
            return [Line($"cd: {requested}: Not a directory", "error")];

        CurrentPath = resolution.Path;
        return [];
    }

    private IReadOnlyList<OutputLine> ListDirectory(string[] arguments)
    {
        var longFormat = false;
        string? requested = null;
        foreach (var argument in arguments)
        {
            if (argument == "-l")
                longFormat = true;
            else if (argument.StartsWith('-'))
                return [Line($"ls: invalid option -- '{argument}'", "error")];
            else if (requested is null)
                requested = argument;
            else
                return [Line("ls: too many arguments", "error")];
        }

        requested ??= ".";
        if (!VirtualFileSystem.TryResolve(CurrentPath, requested, out var resolution))
            return [Line($"ls: cannot access '{requested}': No such file or directory", "error")];

        if (resolution.Node is FileNode file)
            return [FileSystemLink(file, resolution.Path, longFormat)];

        var directory = (DirectoryNode)resolution.Node;
        return directory.Children
            .OrderByDescending(node => node is DirectoryNode)
            .ThenBy(node => node.Name, StringComparer.OrdinalIgnoreCase)
            .Select(node => FileSystemLink(node, ChildPath(resolution.Path, node.Name), longFormat))
            .ToArray();
    }

    private IReadOnlyList<OutputLine> CatFile(string[] arguments)
    {
        if (arguments.Length == 0)
            return [Line("cat: missing file operand", "error")];
        if (arguments.Length > 1)
            return [Line("cat: too many arguments", "error")];

        var requested = arguments[0];
        if (!VirtualFileSystem.TryResolve(CurrentPath, requested, out var resolution))
            return [Line($"cat: {requested}: No such file or directory", "error")];
        if (resolution.Node is not FileNode file)
            return [Line($"cat: {requested}: Is a directory", "error")];

        return file.Read().Lines;
    }

    private IReadOnlyList<OutputLine> TreeLines(string[] arguments)
    {
        if (arguments.Length > 1)
            return [Line("tree: too many arguments", "error")];

        var requested = arguments.Length == 0 ? "." : arguments[0];
        if (!VirtualFileSystem.TryResolve(CurrentPath, requested, out var resolution))
            return [Line($"tree: {requested}: No such file or directory", "error")];

        List<OutputLine> lines = [Line(resolution.Path)];
        if (resolution.Node is DirectoryNode directory)
            AddTreeChildren(directory, string.Empty, lines);
        lines.Add(Line(string.Empty));
        lines.Add(Line($"{CountDirectories(resolution.Node)} directories, {CountFiles(resolution.Node)} files"));
        return lines;
    }

    private static void AddTreeChildren(DirectoryNode directory, string prefix, ICollection<OutputLine> lines)
    {
        var children = directory.Children
            .OrderByDescending(node => node is DirectoryNode)
            .ThenBy(node => node.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        for (var index = 0; index < children.Length; index++)
        {
            var child = children[index];
            var last = index == children.Length - 1;
            lines.Add(Line($"{prefix}{(last ? "`-" : "|-")} {child.Name}{(child is DirectoryNode ? "/" : string.Empty)}"));
            if (child is DirectoryNode childDirectory)
                AddTreeChildren(childDirectory, prefix + (last ? "   " : "|  "), lines);
        }
    }

    private static int CountDirectories(FsNode node) => node is DirectoryNode directory
        ? 1 + directory.Children.Sum(CountDirectories)
        : 0;

    private static int CountFiles(FsNode node) => node is DirectoryNode directory
        ? directory.Children.Sum(CountFiles)
        : 1;

    private static OutputLine FileSystemLink(FsNode node, string path, bool longFormat)
    {
        var directory = node is DirectoryNode;
        var name = node.Name + (directory ? "/" : string.Empty);
        var label = longFormat ? $"{(directory ? 'd' : '-')}r--r--r--  {name}" : name;
        var command = directory ? "cd " + path : "cat " + path;
        return new LinkLine(label, command, LinkKind.Command) { Style = directory ? "accent directory" : "accent" };
    }

    private static string ChildPath(string parent, string name) => parent == "~" ? $"~/{name}" : $"{parent}/{name}";

    private IReadOnlyList<OutputLine> SetTheme(string[] arguments)
    {
        if (arguments.Length == 0)
            return new[] { Line("Themes: green, amber. Current: " + Theme.Replace("theme-", string.Empty)) };

        var requested = arguments[0].ToLowerInvariant();
        if (requested != "green" && requested != "amber")
            return new[] { Line("theme: choose 'green' or 'amber'", "error") };

        Theme = "theme-" + requested;
        return new[] { Line("Theme changed to " + requested + ".") };
    }

    private static IReadOnlyList<OutputLine> GitHubLines()
    {
        return
        [
            Line("GITHUB / tombiddulph", "heading"),
            Line("35 public repositories / 2 public gists / member since 2016"),
            External("github.com/tombiddulph", TerminalContent.GitHubUrl),
            Link("run: projects", "projects"),
            Link("run: contributions", "contributions")
        ];
    }

    private static IReadOnlyList<OutputLine> NeofetchLines()
    {
        return [new RawLine(string.Empty, RawLineKind.Neofetch)];
    }

    private static IReadOnlyList<OutputLine> ManLines(string[] arguments)
    {
        if (arguments.Length > 0 && !arguments[0].Equals("tom", StringComparison.OrdinalIgnoreCase))
            return [Line("No manual entry for " + arguments[0], "error")];

        return
        [
            Line("TOM(1)                       PORTFOLIO MANUAL                       TOM(1)", "heading"),
            Line(string.Empty),
            Line("NAME", "heading"),
            Line("    Tom Biddulph - senior software engineer"),
            Line(string.Empty),
            Line("SYNOPSIS", "heading"),
            Line("    Backend-focused C# engineer building reliable web and fintech systems."),
            Line(string.Empty),
            Line("DESCRIPTION", "heading"),
            Line("    Builds accessible financial products at NewDay and open-source developer"),
            Line("    tooling around Azure, distributed messaging, and observability."),
            Line(string.Empty),
            Line("SEE ALSO", "heading"),
            Link("    resume(1), projects(1), contributions(1), contact(1)", "resume")
        ];
    }

    private static IReadOnlyList<OutputLine> ResumeLines()
    {
        return TerminalFormatter.Resume();
    }

    private static IReadOnlyList<OutputLine> StackLines()
    {
        return TerminalFormatter.Stack();
    }

    private static IReadOnlyList<OutputLine> TimelineLines()
    {
