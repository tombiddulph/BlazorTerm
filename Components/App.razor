<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080b0a" />
    <meta name="author" content="Tom Biddulph" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script>try{document.documentElement.dataset.terminalTheme=localStorage.getItem("blazorterm-theme")||""}catch{}try{if(location.pathname==="/"&&!matchMedia("(prefers-reduced-motion: reduce)").matches&&sessionStorage.getItem("blazorterm-boot-seen")!=="true"){sessionStorage.setItem("blazorterm-boot-seen","true");document.documentElement.classList.add("terminal-boot-pending");setTimeout(()=>document.documentElement.classList.remove("terminal-boot-pending"),4000)}}catch{}</script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorTerm.styles.css"]" />
    <ImportMap />
    <script type="application/ld+json">@((MarkupString)PersonJsonLd)</script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <noscript>
        <PortfolioOverview Class="static-page noscript-content" />
    </noscript>
    <ReconnectModal />
    <script src="@Assets["terminal.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly string PersonJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = TerminalContent.Profile.Name,
        ["url"] = TerminalContent.SiteUrl,
        ["jobTitle"] = TerminalContent.Profile.Role,
        ["address"] = new Dictionary<string, string>
        {
            ["@type"] = "PostalAddress",
            ["addressLocality"] = TerminalContent.City,
            ["addressCountry"] = TerminalContent.CountryCode
        },
        ["sameAs"] = TerminalContent.ContactLinks.Select(link => link.Url).ToArray()
    });
}
